# Base URL for REST calls (health check / engine API). Points at the server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Socket.IO server URL for realtime gameplay. Must point at the server, NOT the
# Next dev server — if unset, Socket.IO falls back to the page origin
# (localhost:3000) and every connection 404s.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080
